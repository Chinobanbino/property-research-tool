# Postgres connection string (Railway sets this when you add a Postgres database)
DATABASE_URL=
# Set to true only if your database requires SSL from outside Railway
PGSSL=
# Main address; other feearmor.com hosts redirect here (e.g. www.feearmor.com)
CANONICAL_HOST=
# Long random secret for /admin/waitlist.csv?token=... and /admin/stats?token=...
ADMIN_TOKEN=
# Staff dashboard (/dashboard): shared password, and staff as Name:+1phone pairs
DASHBOARD_PASSWORD=
STAFF=Gio:+1XXXXXXXXXX,Jaime:+1XXXXXXXXXX
# Twilio: texts to staff only (new signups, booked calls, 1-hour reminders, 8am list)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use one of these two
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
